---
layout: null
permalink: /search.json
sitemap: false
---
{%- assign live_posts = site.posts | where_exp: "p", "p.noindex != true" -%}
[
{%- for post in live_posts -%}
{%- unless forloop.first -%},{%- endunless -%}
{%- comment -%}
  把文章各區塊的文字攤平成一段純文字，讓搜尋可以搜到內文，
  不是只有標題。截斷到 1200 字避免索引檔過大。
{%- endcomment -%}
{%- capture body_text -%}
  {{ post.content }}
  {%- for s in post.article_sections -%}
    {{ s.text }} {{ s.title }} {{ s.content }} {{ s.caption }} {{ s.alt }} {{ s.intro }}
    {%- for item in s.items -%}{{ item.question }} {{ item.answer }}{%- endfor -%}
    {%- for h in s.headers -%}{{ h }} {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign body_text = body_text | strip_html | normalize_whitespace | truncate: 1200 -%}
{%- assign cat = site.category_list | where: "name", post.category | first -%}
{
  "title": {{ post.title | strip_html | jsonify }},
  "url": {{ post.url | relative_url | jsonify }},
  "date": {{ post.date | date: "%Y.%m.%d" | jsonify }},
  "iso": {{ post.date | date_to_xmlschema | jsonify }},
  "category": {{ post.category | jsonify }},
  "categoryUrl": {% if cat %}{{ '/categories/' | append: cat.slug | append: '/' | relative_url | jsonify }}{% else %}""{% endif %},
  "summary": {{ post.quick_answer | default: post.meta_description | default: post.excerpt | strip_html | normalize_whitespace | truncate: 160 | jsonify }},
  "tags": {% if post.tags and post.tags.size > 0 %}{{ post.tags | jsonify }}{% else %}[]{% endif %},
  "image": {% if post.image %}{{ post.image | relative_url | jsonify }}{% else %}""{% endif %},
  "body": {{ body_text | jsonify }}
}
{%- endfor -%}
]
